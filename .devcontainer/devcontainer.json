{
  "name": "Interplanetary Fund",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "IFund frontend and independent API", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "settings": { "terminal.integrated.cwd": "${containerWorkspaceFolder}" }
    }
  }
}
