{
  "name": "interplanetaryfund",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js tests/*.test.mjs worker/agents/*.test.mjs workers/ifund-payments/*.test.mjs integrations/*.test.mjs",
    "reconcile": "node scripts/reconcile-production-schema.mjs",
    "audit:release": "node scripts/verify-dependency-audit.mjs",
    "test:release": "node --test tests/verify-scoped-release.test.mjs",
    "release:scoped": "node scripts/verify-scoped-release.mjs",
    "test:browser:policy": "node --test tests/agent-browser-policy.test.mjs",
    "audit:browser:desktop": "playwright install chromium && node scripts/agent-browser-audit.mjs --json browser-desktop.local",
    "audit:browser:mobile": "playwright install chromium && node scripts/agent-browser-audit.mjs --mobile --json browser-mobile.local",
    "setup:browser": "playwright install chromium",
    "preflight:production": "node scripts/preflight-production.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.105.4",
    "lucide-react": "0.475.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.24",
    "postcss": "8.5.26",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.19",
    "vite": "6.4.6",
    "playwright": "1.56.1"
  }
}
