// Reference only. NOT deployed. Not linked to firebase.json.
// IFund Base44 sessions do not satisfy Firebase Authentication rules.
// Any future server-side access must use validated Base44 server identity and IAM.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
