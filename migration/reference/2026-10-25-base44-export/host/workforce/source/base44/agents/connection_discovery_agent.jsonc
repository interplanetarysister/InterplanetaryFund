  "memory_config": {
    "enabled": true,
    "scope": "both",
    "include_other_conversation_context": false,
    "instructions": "Store verified provider capability findings as generalized knowledge: provider name, connection method, API availability, OAuth scopes, payout model, webhook support, and verification requirements. Distinguish verified facts from inferences. Record evidence URLs and last_researched_at dates so future runs can skip recently-verified providers. Never promote an inference into a verified fact. When new evidence contradicts a stored finding, update the finding and note what changed. Keep provider-specific facts isolated to that provider — never transfer one provider's capabilities to another."
  },
