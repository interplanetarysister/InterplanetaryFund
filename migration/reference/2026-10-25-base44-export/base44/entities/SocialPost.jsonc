{
  "name": "SocialPost",
  "type": "object",
  "properties": {
    "author_user_id": {
      "type": "string",
      "description": "The user who created this post."
    },
    "author_username": {
      "type": "string",
      "description": "Snapshot of the author's username at post time."
    },
    "author_name": {
      "type": "string",
      "description": "Snapshot of the author's display name at post time."
    },
    "author_avatar_url": {
      "type": "string"
    },
    "author_banner_tier": {
      "type": "string",
      "enum": [
        "none",
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "none",
      "description": "Snapshot of the author's reward banner tier when the post was created."
    },
    "content": {
      "type": "string",
      "description": "The post text."
    },
    "media_url": {
      "type": "string",
      "description": "Optional uploaded image attached to the post."
    },
    "campaign_id": {
      "type": "string",
      "description": "Optional linked campaign this post is about."
    },
    "campaign_title": {
      "type": "string"
    },
    "likes_count": {
      "type": "number",
      "default": 0
    },
    "reposts_count": {
      "type": "number",
      "default": 0
    },
    "comments_count": {
      "type": "number",
      "default": 0
    },
    "is_top_post": {
      "type": "boolean",
      "default": false,
      "description": "Reward: top-placement on the social feed. True for posts from gold+ tier authors."
    },
    "crosspost_platforms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "External platforms this post was cross-posted to."
    },
    "ai_generated": {
      "type": "boolean",
      "default": false,
      "description": "True when the post content was generated by an AI agent."
    },
    "source_platform": {
      "type": "string",
      "description": "The external platform this post was mirrored from (facebook, instagram, tiktok, linkedin, discord). Null for native IFund posts."
    },
    "external_post_id": {
      "type": "string",
      "description": "The external platform's post ID, used for deduplication during sync."
    },
    "external_url": {
      "type": "string",
      "description": "Direct link to the original post on the external platform."
    },
    "agent_managed": {
      "type": "boolean",
      "default": false,
      "description": "True when this post was created or synced by the autonomous social media agent."
    },
    "image_generated": {
      "type": "boolean",
      "default": false,
      "description": "Media image was newly generated or transformed and branded on Interplanetary Fund."
    }
  },
  "required": [
    "author_user_id",
    "content"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "description": "Public IFund social posts and authorized third-party mirrors, not private direct messages."
}