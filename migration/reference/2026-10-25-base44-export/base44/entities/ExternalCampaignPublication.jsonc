{
  "name": "ExternalCampaignPublication",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "staging",
        "production"
      ],
      "default": "staging"
    },
    "status": {
      "type": "string",
      "enum": [
        "request_pending",
        "staging_created",
        "production_verified",
        "needs_attention"
      ],
      "default": "needs_attention"
    },
    "page_short_name": {
      "type": "string"
    },
    "provider_page_id": {
      "type": "string"
    },
    "provider_page_url": {
      "type": "string"
    },
    "provider_charity_id": {
      "type": "string"
    },
    "provider_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "registration_method": {
      "type": "string"
    },
    "test_note": {
      "type": "string"
    }
  },
  "required": [
    "campaign_id",
    "owner_user_id",
    "platform",
    "environment",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "description": "Tracks publication and provider verification of an IFund campaign on an external service."
}