{
  "name": "AdminCredentialReference",
  "type": "object",
  "description": "Non-secret metadata for a Browserbase-managed credential used by Interplanetary Fund-owned external accounts. Secret values are never stored in Base44 entities.",
  "properties": {
    "credential_ref": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "platform_owned_account_id": {
      "type": "string"
    },
    "approval_id": {
      "type": "string"
    },
    "browserbase_secret_id": {
      "type": "string"
    },
    "browserbase_secret_key": {
      "type": "string"
    },
    "allowed_agents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "invalid",
        "revoked"
      ],
      "default": "active"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_use_status": {
      "type": "string",
      "enum": [
        "unused",
        "success",
        "failed",
        "human_required"
      ],
      "default": "unused"
    }
  },
  "required": [
    "credential_ref",
    "platform",
    "browserbase_secret_id",
    "browserbase_secret_key",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
