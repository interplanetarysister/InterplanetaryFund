{
  "name": "LegalAcceptance",
  "type": "object",
  "description": "Server-validated, versioned affirmative consent records. Never inferred from mere site visits.",
  "properties": {
    "owner_user_id": {
      "type": "string"
    },
    "terms_version": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "acceptance_method": {
      "type": "string",
      "enum": [
        "explicit_checkbox_and_button"
      ]
    },
    "terms_path": {
      "type": "string"
    },
    "privacy_path": {
      "type": "string"
    }
  },
  "required": [
    "owner_user_id",
    "terms_version",
    "accepted_at",
    "acceptance_method"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}