{
  "name": "UserCredentialVault",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "description": "Platform catalog ID, not a URL"
    },
    "ciphertext": {
      "type": "string",
      "description": "AES-GCM ciphertext encrypted locally with an owner-controlled passphrase; never plaintext"
    },
    "iv": {
      "type": "string"
    },
    "salt": {
      "type": "string"
    },
    "version": {
      "type": "number"
    },
    "iterations": {
      "type": "number"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  },
  "description": "Owner-only zero-knowledge encrypted password storage. Admin users do not receive access to others' vaults; no backend or AI agent receives decryption passphrase."
}
