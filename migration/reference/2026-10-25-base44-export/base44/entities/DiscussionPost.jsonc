{
  "name": "DiscussionPost",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "announcement",
        "question",
        "idea",
        "success_story",
        "coordination",
        "support"
      ],
      "default": "question"
    },
    "author_name": {
      "type": "string"
    },
    "reply_count": {
      "type": "number",
      "default": 0
    },
    "pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "community_id",
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "description": "Posts within the IFund social community/discussion feed."
}