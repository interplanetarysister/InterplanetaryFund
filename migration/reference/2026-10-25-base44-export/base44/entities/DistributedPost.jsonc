{
  "type": "object",
  "name": "DistributedPost",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "campaign_title": {
      "type": "string"
    },
    "connection_id": {
      "type": "string",
      "description": "The PlatformConnection this post targets."
    },
    "platform": {
      "type": "string"
    },
    "source_update_id": {
      "type": "string",
      "description": "When this post was generated from a campaign update cross-post, the originating CampaignUpdate id."
    },
    "content": {
      "type": "string",
      "description": "Platform-tailored post text generated by the Distribution Engine."
    },
    "media_url": { "type": "string", "description": "Owner-selected image for this external post; direct publishing must preserve this media or use manual sharing." },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "scheduled",
        "published",
        "failed",
        "publishing"
      ],
      "default": "draft"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "external_post_url": {
      "type": "string"
    },
    "donation_destination_url": {
      "type": "string"
    },
    "donation_destination_platform": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "owner_user_id": {
      "type": "string",
      "description": "Authenticated campaign owner for system-generated posts; never IFund's service-role author."
    },
    "origin": {
      "type": "string",
      "enum": [
        "creator",
        "agent_autopilot",
        "ifund_official"
      ],
      "default": "creator"
    },
    "publishing_started_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "campaign_id",
    "platform",
    "content"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "description": "Per-platform publishing records, campaign links, authorization checks, and observed results."
}