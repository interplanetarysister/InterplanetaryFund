{
  "name": "AdminCredentialVault",
  "type": "object",
  "description": "Deprecated reference-only compatibility entity. Raw credentials are never stored here; provider-managed secret references only.",
  "properties": {
    "credential_ref": {
      "type": "string",
      "description": "Opaque reference stored on PlatformOwnedAccount."
    },
    "platform": {
      "type": "string"
    },
    "platform_owned_account_id": {
      "type": "string"
    },
    "approval_id": {
      "type": "string"
    },
    "browserbase_secret_id": {
      "type": "string",
      "description": "Provider-managed Browserbase secret identifier only."
    },
    "browserbase_secret_key": {
      "type": "string",
      "description": "Provider-managed Browserbase secret key reference only; never secret material."
    },
    "allowed_agents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "invalid",
        "revoked"
      ],
      "default": "active"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_use_status": {
      "type": "string",
      "enum": [
        "unused",
        "success",
        "failed",
        "human_required"
      ],
      "default": "unused"
    }
  },
  "required": [
    "credential_ref",
    "platform",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}