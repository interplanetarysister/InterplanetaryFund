{
  "name": "Withdrawal",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "The campaign owner who requested the payout; the only user (besides admins) allowed to see and act on this withdrawal."
    },
    "user_name": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "campaign_title": {
      "type": "string"
    },
    "gross_amount": {
      "type": "number",
      "description": "Total cleared recipient funds reserved in the canonical ledger before payout."
    },
    "platform_fee": {
      "type": "number",
      "description": "3% Interplanetary Fund fee deducted once at payout."
    },
    "net_amount": {
      "type": "number",
      "description": "Amount submitted to the user's PayPal account."
    },
    "paypal_email": {
      "type": "string",
      "description": "The PayPal account the payout was sent to."
    },
    "covered_donation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Base44 donation records reserved by this withdrawal. The canonical Base44 FinancialOperation reservation is the authoritative double-spend lock."
    },
    "covered_holding_entry_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Verified external-platform settlement ledger entries reserved by this withdrawal."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reserving",
        "processing",
        "under_review",
        "provider_status_unknown",
        "reconciliation_pending",
        "reservation_release_pending",
        "paid",
        "failed",
        "cancelled"
      ],
      "default": "pending"
    },
    "canonical_operation_key": {
      "type": "string",
      "description": "Stable Base44 withdrawal idempotency key."
    },
    "canonical_reservation_id": {
      "type": "string",
      "description": "Canonical Base44 payout reservation id."
    },
    "canonical_ledger_entry_id": {
      "type": "string",
      "description": "Canonical Base44 pending/completed payout ledger entry."
    },
    "payout_batch_id": {
      "type": "string",
      "description": "PayPal payout batch id returned once the payout is submitted."
    },
    "provider_sender_batch_id": {
      "type": "string",
      "description": "Deterministic PayPal sender_batch_id used to prevent duplicate payouts across retries."
    },
    "review_note": {
      "type": "string",
      "description": "Why a withdrawal was held, failed, or requires reconciliation."
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "owner_user_id",
    "campaign_id",
    "gross_amount",
    "net_amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "description": "User withdrawal request and processing state; confirmed payout amounts must derive from authoritative financial records."
}