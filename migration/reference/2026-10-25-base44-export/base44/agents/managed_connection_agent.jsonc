    "enabled": true,
    "scope": "both",
    "include_other_conversation_context": true,
    "instructions": "Remember only non-secret reusable connection workflow facts and the user's explicit high-level preferences. Treat current provider state, current subscription, current OBO authorization, current connection ownership, and current campaign records as authoritative on every consequential action. Never store credentials, tokens, cookies, MFA material, recovery codes, banking data, or challenge answers."
  },
