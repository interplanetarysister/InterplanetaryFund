      "source_path": "base44/workflows/Volunteer Welcome Follow-up.jsonc",
      "sha256": "29d63512363938a2838b4211c55d7de86ffd6b55bc2311aac0141014d2a69e3d",
      "bytes": 1520,
      "definition": {
        "name": "Volunteer Welcome Follow-up",
        "definition": {
          "document": {
            "dsl": "1.0.0",
            "name": "volunteer_welcome_followup",
            "version": "1.0",
            "namespace": "base44"
          },
          "do": [
            {
              "welcome": {
                "call": "invoke_backend_function",
                "with": {
                  "function_name": "welcomeVolunteer",
                  "args": {
                    "signup_id": "${ .trigger.entity_id }"
                  }
                },
                "then": "wait_period",
                "x-base44": {
                  "title": "Send welcome",
                  "description": "Email + in-app welcome"
                }
              }
            },
            {
              "wait_period": {
                "wait": "P3D",
                "then": "follow_up"
              }
            },
            {
              "follow_up": {
                "call": "invoke_backend_function",
