# Supabase project used by the public site (publishable/anon values only).
# Never commit real values. Copy to .env.local for local development.
VITE_SUPABASE_URL=https://ssibsfmtodgximseeqsv.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional public Google Picker configuration. Use an origin-restricted API key.
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_PICKER_KEY=
VITE_GOOGLE_DRIVE_PROJECT_NUMBER=

# Private campaign documents remain OFF until the private Supabase Storage bucket,
# metadata/RLS migrations and two-account acceptance tests are verified.
# Browser-safe flag; never put a server Supabase secret into VITE_* values.
VITE_IFUND_CAMPAIGN_DOCUMENTS_ENABLED=disabled
