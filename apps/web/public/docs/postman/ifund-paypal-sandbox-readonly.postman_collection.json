{
  "info": {
    "name": "iFund · PayPal Sandbox API · Safe Postman Tests",
    "description": "Read-only PayPal AI Hackathon API smoke tests; none create transactions or persist financial records. Running this collection is not evidence of a captured PayPal payment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "sandbox_origin",
      "value": "https://feature-paypal-sandbox-secur.interplanetaryfund-migration.pages.dev",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Sandbox status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{sandbox_origin}}/api/paypal/sandbox/status",
        "description": "GET-only configuration check."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sandbox status returns JSON', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json'); });",
              "const data=pm.response.json();",
              "pm.test('No live payments', () => { pm.expect(data.mode).to.eql('sandbox'); pm.expect(data.live_payments_enabled).to.eql(false); });",
              "pm.test('Provider and database readiness', () => { pm.expect(data.enabled).to.eql(true); pm.expect(data.webhook_ready).to.eql(true); pm.expect(data.database_ready).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Redacted sandbox diagnostics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{sandbox_origin}}/api/paypal/sandbox/diagnostics",
        "description": "Read-only gateway diagnostic check."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Diagnostics JSON available', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Judge demo route",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/html"
          }
        ],
        "url": "{{sandbox_origin}}/hackathon",
        "description": "Checks HTML response, not app runtime."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Demo page responds with HTML', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type') || '').to.include('text/html'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Order endpoint must reject GET",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{sandbox_origin}}/api/paypal/sandbox/orders",
        "description": "Safe negative method test. Never change to POST for automated runs."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unsafe GET method rejected', () => pm.response.to.have.status(405));"
            ]
          }
        }
      ]
    }
  ]
}
