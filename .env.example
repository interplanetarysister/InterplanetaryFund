# Only publishable/browser-safe values. Set locally; never commit secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional independent API origin. Leave blank to use same-origin /api routes.
VITE_API_BASE_URL=

# Leave disabled until the independent Cloudflare Worker route and auth/RLS are verified.
VITE_IFUND_CAMPAIGN_API=disabled

# Independent community post/create/delete Worker endpoint; not production ready.
VITE_IFUND_COMMUNITY_API=disabled
