# Convex backend URL (production)
VITE_CONVEX_URL=https://rosy-butterfly-2.convex.cloud

# Convex deployment name (for CLI)
CONVEX_DEPLOYMENT=rosy-butterfly-2

# Browserbase — browser automation for all IF agents
BROWSERBASE_API_KEY=your_browserbase_api_key_here
BROWSERBASE_PROJECT_ID=your_browserbase_project_id_here
# Persisted Browserbase Context IDs containing authorized social logins.
# Platform-specific values override the shared context when supplied.
BROWSERBASE_SOCIAL_CONTEXT_ID=your_shared_social_context_id_here
BROWSERBASE_FACEBOOK_CONTEXT_ID=your_facebook_context_id_here
BROWSERBASE_INSTAGRAM_CONTEXT_ID=your_instagram_context_id_here

# Social publishing
BLUESKY_IDENTIFIER=your_bluesky_handle_here
BLUESKY_APP_PASSWORD=your_bluesky_app_password_here
# Used after a successful Instagram browser submission to verify the new permalink.
INSTAGRAM_PROFILE_URL=https://www.instagram.com/your_profile/
# Optional Facebook destination fallback. Campaign group outreach normally chooses
# an eligible joined group from Convex automatically.
FACEBOOK_OUTREACH_TARGET_URL=https://www.facebook.com/your_page_or_group/

# Provider-neutral subscription webhook authentication
SUBSCRIPTION_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Resend — Email delivery for donor communications
RESEND_API_KEY=your_resend_api_key_here

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Never enable in production. Only permits unsigned Stripe payloads in explicit local/test environments.
ALLOW_UNVERIFIED_STRIPE_WEBHOOKS=false
