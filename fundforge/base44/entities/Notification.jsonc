{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "donation",
        "milestone",
        "comment",
        "follow",
        "update",
        "ending",
        "payout"
      ],
      "default": "comment"
    },
    "message": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "recipient_id",
    "type",
    "message"
  ]
}