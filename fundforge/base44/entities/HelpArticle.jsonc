{
  "name": "HelpArticle",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "Getting Started",
        "Creating Campaigns",
        "Donating",
        "Payouts",
        "Account & Security"
      ]
    },
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "helpful_yes": {
      "type": "number",
      "default": 0
    },
    "helpful_no": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "category",
    "question",
    "answer"
  ]
}